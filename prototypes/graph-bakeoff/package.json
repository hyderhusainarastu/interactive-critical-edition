{
  "name": "graph-bakeoff",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Isolated Stage 2 renderer bakeoff harness for the Palimnote Knowledge Map rebuild. Not part of the main pnpm workspace.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "generate:fixtures": "tsx src/fixtures/generate.ts"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.185.1",
    "react-force-graph-3d": "1.29.1",
    "@react-three/fiber": "^9.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
