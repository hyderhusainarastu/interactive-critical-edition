# Copy to .env.local (web) / .env (worker) and fill in real values.
# NEVER commit a file containing actual secrets.

# --- Database (Supabase Postgres, pgvector enabled) ---
DATABASE_URL=
DIRECT_URL=

# --- Supabase (Storage + project config) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# --- Auth.js (NextAuth) ---
AUTH_SECRET=
AUTH_URL=

# --- AI providers (multi-provider: routing config decides which handles which task) ---
# With neither key set, the analysis pipeline runs against a deterministic
# heuristic fallback (annotations are flagged as such) instead of a real model.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: override the cheap-tier model IDs used by the cost-first router
# (packages/ai-adapters/src/routing.ts). Defaults: gpt-5.4-nano / gpt-5.4-mini / claude-haiku-4-5.
OPENAI_MODEL_CHEAP=
OPENAI_MODEL_RESEARCH=
ANTHROPIC_MODEL_CHEAP=
# Optional: v4's compact cross-work signal embedding model.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: override the OpenAI API base URL. Defaults to https://api.openai.com/v1.
OPENAI_BASE_URL=

# --- Phase 8 edition pipeline ---
# v1 is the deployed-safe legacy default. v2 is the current production
# pipeline. v3 is the current production default. v4 remains release-gated:
# set both ANALYSIS_PIPELINE=v4 and PHASE_12_PIPELINE_V4_ENABLED=true only
# after an owner-approved production migration and canary.
ANALYSIS_PIPELINE=v1
# --- Phase 12 production-workspace release controls ---
# Foundation is enabled by default. The remaining flags are intentionally off
# until their corresponding part has passed its verification and rollout.
PHASE_12_FOUNDATION_ENABLED=true
PHASE_12_LIBRARY_IDENTITY_ENABLED=false
PHASE_12_PIPELINE_V4_ENABLED=false
PHASE_12_INTERACTIVE_READER_ENABLED=false
PHASE_12_CROSS_LIBRARY_GRAPH_ENABLED=false
PHASE_12_WRITER_ENABLED=false
# --- Phase 18 RAG chat release controls ---
PHASE_18_RAG_ENABLED=false
# Gated structured-model tier on top of the deterministic extractive
# fallback (packages/rag). Off by default even when PHASE_18_RAG_ENABLED=true.
PHASE_18_RAG_PROVIDER_ENABLED=false
# Phase 29.3 (ScholarLens reverse-direction lane): hybrid dense+BM25
# retrieval for Ask Library (packages/rag/src/hybridRetrieval.ts), unioned
# with the existing lexical scorer's channel. Off by default: retrieval
# stays lexical-only (today's behavior) until the ported search-relevance
# eval (scripts/research/rag-retrieval-eval.mts,
# docs/eval/research-claims/rag-hybrid-retrieval-eval.md) is re-run and
# shows a real recall improvement. Degrades honestly to lexical-only when no
# embedding provider (OPENAI_API_KEY) is configured, even if set to true.
RAG_HYBRID_RETRIEVAL=false
# --- Sub-phase 22.9b conversational competency designation (plan §3.5) ---
# Whole feature, including the zero-cost deterministic self-report detector.
# Enabled first, only after a cost-logged production canary verifies ledger
# rows, undo, and caps.
PHASE_22_COMPETENCY_ENABLED=false
# The gated structured-model-call tier on top of the detector. Enabled only
# after PHASE_22_COMPETENCY_ENABLED, per the plan's own ordering.
PHASE_22_COMPETENCY_PROVIDER_ENABLED=false
# --- Phase 25 research workspace release controls (ScholarLens integration) ---
# One flag per user-visible surface, all off until that surface has passed its
# own verification. Release controls only — every route still does its own
# auth/ownership check regardless (see packages/config/src/phase25.ts).
PHASE_25_RESEARCH_ENABLED=false
PHASE_25_READER_CLAIM_LAYER_ENABLED=false
PHASE_25_GRAPH_DEBATE_LAYER_ENABLED=false
PHASE_25_WRITER_EVIDENCE_ENABLED=false
PHASE_25_ASK_RESEARCH_MODES_ENABLED=false
# Scheduled monitors — the one research surface that can act with no user
# present. Off here AND cadence-paused in the monitor rows themselves.
PHASE_25_MONITORING_ENABLED=false
# The interpretive judge branch. Stays off until the humanities gold set clears
# its measured floors; until then humanities pairs use the base 4-way judge.
PHASE_25_HUMANITIES_JUDGE_ENABLED=false
# temporary beta gate — remove after beta
BETA_TESTING_MODE=false
GROBID_URL=http://localhost:8070
# Required only when GROBID_URL points at a private Cloud Run service (prod):
# a Google service-account JSON key, used to mint a self-signed ID token.
GROBID_SA_KEY=
GROBID_MAX_CONCURRENCY=
GROBID_TIMEOUT_MS=
# Optional private ClamAV-compatible scanner endpoint. When absent, uploads
# receive format/archive validation only (not a misleading malware claim).
CLAMAV_SCAN_URL=
# Scanned/OCR PDF ingestion (Phase 8)
OCR_LANGUAGE=
OCR_MAX_PAGES=
# Extraction job expiration under queue backlog, and the sweep window for
# runs abandoned mid-flight (deploy drain, crash) — see Known Problems.
EXTRACT_EXPIRE_MINUTES=
STALE_RUN_MINUTES=
# Give an in-flight run time to finish before Render drains the old instance
# on deploy.
RENDER_SHUTDOWN_DELAY=

# --- Background jobs (pg-boss uses DATABASE_URL directly; no separate queue URL needed) ---

# --- Bibliographic APIs ---
OPENALEX_POLITE_POOL_EMAIL=
CROSSREF_POLITE_POOL_EMAIL=
GOOGLE_BOOKS_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# --- Phase 8 research pipeline (evidence-first discovery, packages/research) ---
# Keyless scholarly sources (Crossref/OpenAlex/OpenLibrary/Semantic Scholar)
# are always on. These free-tier keys activate the web/social lanes; a
# provider stays honestly "disabled" (never silently skipped) without one.
TAVILY_API_KEY=
YOUTUBE_API_KEY=
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
# Comma-separated provider names to force-disable regardless of key presence.
RESEARCH_DISABLED_PROVIDERS=
# Cost caps in USD: no synthesis call begins if its projected maximum would
# cross the hard cap (see canAfford() in packages/research/src/discover.ts).
RESEARCH_COST_SOFT_CAP=
RESEARCH_COST_HARD_CAP=
RESEARCH_MAX_INSPECTIONS=
RESEARCH_MAX_CITATION_LOOKUPS=

# --- Email delivery ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Admin (Phase 7) ---
# Comma-separated emails granted access to /admin. Unset = no admins.
ADMIN_EMAILS=

# --- Admin dashboard (Workstream H, v.5) ---
# A separate, credential-gated dashboard at /admin-dash — independent of
# /admin and ADMIN_EMAILS above, and of the normal user session entirely.
# Any ONE of these three unset makes the whole /admin-dash tree 404 (fail
# closed by design; see apps/web/src/lib/adminDash.ts). Generate a random
# password, hash it with bcryptjs at cost 12, and never commit the plaintext
# or the hash anywhere.
ADMIN_DASH_USERNAME=
# Gotcha (cost a real debugging session, D-style note): in a LOCAL .env.local
# file, Next's env loader (@next/env) runs dotenv-expand AFTER parsing, which
# treats an unescaped `$word` in a value as a variable reference and silently
# replaces it with "" if that variable doesn't exist — this corrupts a bcrypt
# hash's `$2b$12$...` prefix into garbage with no error at all (the login
# route then just always rejects the correct password). Escape every `$` as
# `\$` in .env.local (e.g. `\$2b\$12\$...`); wrapping the value in quotes
# does NOT help, since dotenv's quote-stripping runs before expansion. This
# does not affect Vercel's production environment store (no dotenv parsing
# there), so this is a local-dev-only pitfall.
ADMIN_DASH_PASSWORD_HASH=
# >= 32 random bytes (e.g. `openssl rand -base64 48`). Rotating this
# immediately invalidates every outstanding admin-dash session.
ADMIN_DASH_SECRET=

# --- Error monitoring ---
# Server errors are captured by the dormant Sentry SDK when SENTRY_DSN is set.
# The browser SDK is independently opt-in via the public DSN value below.
# Both are optional; structured platform logging remains active either way.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- App config ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
